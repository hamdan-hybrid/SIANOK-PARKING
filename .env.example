# Tidak perlu diisi manual: sudo bash setup.sh membuat .env (user database & password acak), lihat INSTALL.md.
# Contoh isi .env bila ingin diisi manual:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db-sianok-parking
DB_USER=sianok_parking
DB_PASSWORD=
PORT=3003
# Teks acak panjang (mis. hasil: openssl rand -hex 32). Jangan diubah setelah dipakai.
USER_ID_SECRET=
# Opsional: alamat publik dashboard, mis. https://parkir.domain-client.com
SITE_URL=
